# Browser configuration (the Supabase anon key is public; protect data with RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave blank for Docker Compose's same-origin /api proxy; set for a separately hosted API.
VITE_API_BASE_URL=

# Server-only configuration. Never prefix these with VITE_ or expose them to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Comma-separated browser origins if the API is hosted separately.
FRONTEND_ORIGINS=
# Docker Compose frontend port on the host (default 8080).
FRONTEND_PORT=8080
# Dev proxy target; normally the Python API on localhost:8000.
API_PROXY_TARGET=http://127.0.0.1:8000
