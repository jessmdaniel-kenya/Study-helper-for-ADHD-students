# Browser configuration (the Supabase anon key is public; protect data with RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only configuration. Never prefix these with VITE_ or expose them to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Python provider service. For local development, start it at this URL.
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000
PYTHON_AI_SERVICE_TOKEN=replace-with-a-long-random-secret

# Configure keys only for the providers you use. Never prefix keys with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
# Or use GOOGLE_API_KEY.
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional NVIDIA aliases and endpoint override:
# AI_API_KEY=
# AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
